  {
    "id": "lookup-close-and-reopen",
    "intent": "The user can dismiss the panel and then perform another lookup without stale UI being left behind",
    "steps": [
      {
        "action": "lookup",
        "targetId": "word-success",
        "word": "Example",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedSelection": "Example"
      },
      {
        "action": "closePanel",
        "expectedPanelVisible": false,
        "expectedBowlVisible": false
      },
      {
        "action": "lookup",
        "targetId": "word-error",
        "word": "offlineword",
        "bingFixture": null,
        "expectedPanelState": "error",
        "expectedItemState": "error",
        "expectedSelection": "offlineword"
      }
    ]
  },
  {
    "id": "lookup-add-to-notebook",
    "intent": "After a successful lookup, the user can add the word to notebook and the saved state becomes observable in both UI and storage",
    "steps": [
      {
        "action": "lookup",
        "targetId": "word-notebook",
        "word": "notebookword",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedSelection": "notebookword",
        "expectedFavActive": false
      },
      {
        "action": "addToNotebook",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedQueryText": "notebookword",
        "expectedFavActive": true,
        "expectedSavedText": "notebookword"
      }
    ]
  },
  {
    "id": "lookup-history-navigation",
    "intent": "After multiple lookups, the user can move backward and forward through lookup history and get the corresponding results",
    "steps": [
      {
        "action": "lookup",
        "targetId": "word-success",
        "word": "Example",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedSelection": "Example",
        "expectedHistoryBackDisabled": true,
        "expectedHistoryForwardDisabled": true
      },
      {
        "action": "lookup",
        "targetId": "word-empty",
        "word": "zzzznotaword",
        "bingFixture": "bing-empty.html",
        "expectedPanelState": "empty",
        "expectedItemState": "empty",
        "expectedSelection": "zzzznotaword",
        "expectedHistoryBackDisabled": false,
        "expectedHistoryForwardDisabled": true
      },
      {
        "action": "historyBack",
        "query": "Example",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedQueryText": "Example",
        "expectedHistoryBackDisabled": true,
        "expectedHistoryForwardDisabled": false
      },
      {
        "action": "historyForward",
        "query": "zzzznotaword",
        "bingFixture": "bing-empty.html",
        "expectedPanelState": "empty",
        "expectedItemState": "empty",
        "expectedQueryText": "zzzznotaword",
        "expectedHistoryBackDisabled": false,
        "expectedHistoryForwardDisabled": true
      }
    ]
  },
  {
    "id": "lookup-long-selection-translation",
    "intent": "Selecting a long sentence should fall back to machine translation instead of ending in a blank or all-empty panel",
    "runtime": {
      "selectedDicts": ["google"]
    },
    "steps": [
      {
        "action": "lookup",
        "targetId": "sentence-long",
        "rangeStartWord": "general",
        "rangeEndWord": "China",
        "googleFixture": "google-long-success.json",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedDictId": "google",
        "expectedSelection": "general secretary of the Communist Party of China"
      }
    ]
  },
  {
    "id": "lookup-long-selection-fragment-translation",
    "intent": "Selecting a long fragment that starts or ends inside a word should still reach a translated terminal state",
    "runtime": {
      "selectedDicts": ["google"]
    },
    "steps": [
      {
        "action": "lookup",
        "targetId": "sentence-fragment",
        "rangeStartWord": "general",
        "rangeStartInset": 8,
        "rangeEndWord": "Central",
        "rangeEndFrom": "left",
        "rangeEndInset": 10,
        "googleFixture": "google-fragment-success.json",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedDictId": "google",
        "expectedSelection": "eneral secretary of the Communist Party of China C"
      }
    ]
  },
