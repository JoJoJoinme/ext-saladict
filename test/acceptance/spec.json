  {
    "id": "lookup-terminal-transitions",
    "intent": "When the user selects a new word, the panel must replace the previous terminal state instead of showing stale success or stale error",
    "steps": [
      {
        "action": "lookup",
        "targetId": "word-success",
        "word": "Example",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedSelection": "Example"
      },
      {
        "action": "lookup",
        "targetId": "word-empty",
        "word": "zzzznotaword",
        "bingFixture": "bing-empty.html",
        "expectedPanelState": "empty",
        "expectedItemState": "empty",
        "expectedSelection": "zzzznotaword"
      },
      {
        "action": "lookup",
        "targetId": "word-error",
        "word": "offlineword",
        "bingFixture": null,
        "expectedPanelState": "error",
        "expectedItemState": "error",
        "expectedSelection": "offlineword"
      },
      {
        "action": "lookup",
        "targetId": "word-success",
        "word": "Example",
        "bingFixture": "bing-success.html",
        "expectedPanelState": "success",
        "expectedItemState": "success",
        "expectedSelection": "Example"
      }
    ]
  },
  {
