{
  "name": "saladict",
  "version": "7.20.2",
  "description": "Chrome extension; inline translator powered by multiple online dictionaries",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "type-check": "tsc --noEmit",
    "test:phase-dispatch": "node scripts/check-phase-dispatch.mjs",
    "test:phase-workflow": "node scripts/check-phase-workflow.mjs",
    "test:phase-protocol": "node scripts/check-phase-protocol.mjs && node scripts/check-phase-dispatch.mjs && node scripts/check-phase-workflow.mjs",
    "test:bdd-gate": "node scripts/check-bdd-gate.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --testTimeout 20000",
    "test:acceptance:spec": "node scripts/check-acceptance-spec.mjs",
    "test:acceptance": "npm run build && npm run test:acceptance:spec && xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' node test/acceptance/playwright-acceptance.mjs",
    "test:e2e": "xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' node test/e2e/extension-e2e.mjs",
    "test:e2e:playwright": "xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' node test/e2e/playwright-e2e.mjs",
    "test:required": "npm test -- --runInBand test/specs/content/acceptance/lookup-contract.spec.ts && npm run test:acceptance && npm run test:e2e:playwright",
    "test:watch": "jest --watch",
    "commit": "git-cz",
    "release": "standard-version",
    "lint": "eslint src/**/*.{js,ts,tsx}"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crimx/ext-saladict"
  },
  "homepage": "https://github.com/crimx/ext-saladict",
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/crimx/ext-saladict/issues"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^4.0.5",
    "@opentranslate/baidu": "^1.4.0",
    "@opentranslate/caiyun": "^1.4.0",
    "@opentranslate/google": "^1.4.0",
    "@opentranslate/languages": "^1.4.0",
    "@opentranslate/sogou": "^1.4.0",
    "@opentranslate/tencent": "^1.4.0",
    "@opentranslate/translator": "^1.4.0",
    "@opentranslate/youdao": "^1.4.0",
    "@types/classnames": "^2.2.10",
    "@types/dompurify": "0.0.32",
    "@types/firefox-webext-browser": "^67.0.2",
    "@types/i18next": "^12.1.0",
    "@types/lodash": "^4.14.136",
    "@types/react": "^16.8.23",
    "@types/react-beautiful-dnd": "^13.0.0",
    "@types/react-dom": "^16.8.4",
    "@types/react-helmet": "^5.0.15",
    "@types/react-redux": "^7.1.2",
    "@types/react-resize-detector": "^4.0.2",
    "@types/react-textarea-autosize": "^4.3.4",
    "@types/react-transition-group": "^4.2.0",
    "@types/shallowequal": "^1.1.1",
    "@types/uuid": "^3.4.6",
    "@types/wavesurfer.js": "2.0.2",
    "antd": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "axios": "^0.21.1",
    "classnames": "^2.2.6",
    "dexie": "^2.0.4",
    "dompurify": "^2.0.17",
    "get-selection-more": "^1.0.2",
    "i18next": "^17.0.6",
    "lodash": "^4.17.21",
    "md5": "^2.2.1",
    "memoize-one": "^5.1.0",
    "normalize-scss": "^7.0.1",
    "observable-hooks": "^3.0.0",
    "pako": "^1.0.10",
    "postcss-flexbugs-fixes": "^5.0.2",
    "qrcode.react": "^0.9.3",
    "react": "^16.10.0",
    "react-beautiful-dnd": "^13.0.0",
    "react-dom": "^16.10.0",
    "react-helmet": "^6.0.0-beta.2",
    "react-hot-loader": "^4",
    "react-number-editor": "^4.0.3",
    "react-redux": "^7.1.0",
    "react-resize-reporter": "^1.0.2",
    "react-retux": "^0.1.0",
    "react-shadow": "17.1.x",
    "react-textarea-autosize": "^7.1.0",
    "react-transition-group": "^4.2.1",
    "react-use": "^11.3.2",
    "redux": "^4.0.4",
    "redux-observable": "^1.1.0",
    "redux-thunk": "^2.3.0",
    "retux": "^0.1.0",
    "rxjs": "^6.5.2",
    "shallowequal": "^1.1.0",
    "soundtouchjs": "^0.1.24",
    "ua-parser-js": "^2.0.9",
    "utility-types": "^3.7.0",
    "uuid": "^3.4.0",
    "wavesurfer.js": "3.0.0",
    "webextension-polyfill": "^0.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^9.1.2",
    "@types/faker": "^4.1.5",
    "@types/jest": "^29.5.14",
    "@types/md5": "^2.1.33",
    "@types/qs": "^6.9.0",
    "@types/sinon-chrome": "^2.2.6",
    "@typescript-eslint/eslint-plugin": "^2.20.0",
    "@typescript-eslint/parser": "^2.20.0",
    "axios-mock-adapter": "^1.17.0",
    "commitizen": "^4.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^8.2.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-config-standard": "^14.1.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jest": "^23.7.0",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.18.3",
    "eslint-plugin-standard": "^4.0.1",
    "faker": "^4.1.0",
    "fast-glob": "^3.1.1",
    "form-data": "^2.5.1",
    "franc-min": "^4.1.1",
    "husky": "^4.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^2.1.2",
    "node-fetch": "^3.1.1",
    "playwright-core": "^1.58.2",
    "prettier": "^1.19.1",
    "puppeteer-core": "^24.37.2",
    "qs": "^6.9.1",
    "raf": "^3.4.1",
    "random-mua": "^0.5.0",
    "sass": "^1.34.0",
    "sinon-chrome": "^3.0.1",
    "socks-proxy-agent": "^5.0.0",
    "standard-version": "^9.0.0",
    "trsjs": "caiyunapp/trs.js",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0",
    "wxt": "^0.19.0"
  }
}
